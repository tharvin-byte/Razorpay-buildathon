# ReconX Environment Configuration
# Copy this file to .env and insert your values below:

# ─── Gemini AI Integration (Optional) ───────────────────────────────────────
# The assistant copilot uses Gemini when a valid API key is provided.
# Without a key the copilot falls back to deterministic rule-based responses.
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Gemini model to use for assistant queries (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# ─── CORS / Deployment ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no wildcards).
# Default: http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# RECONX_ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# ─── Demo Run Seed ────────────────────────────────────────────────────────────
# Set to 'false' to disable the automatic demo-run-001 on startup.
# Default: true
# RECONX_SEED_DEMO=true

# ─── In-Memory Session Store ──────────────────────────────────────────────────
# Maximum number of run sessions held in memory at once.
# Default: 50
# RECONX_MAX_RUNS=50

# Time-to-live (in seconds) for completed / failed run sessions.
# Default: 86400 (24 hours)
# RECONX_RUN_TTL_SECONDS=86400
