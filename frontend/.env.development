# WHY THIS FILE EXISTS:
# api.js now reads the backend URL from the VITE_API_BASE environment variable
# instead of having "http://127.0.0.1:8000" hardcoded.
#
# This file tells Vite: "when running locally (npm run dev), use localhost:8000 as the backend".
# This is identical to the old hardcoded behaviour — nothing changes for local development.
#
# On Render (production), this file is NOT used. Render injects VITE_API_BASE
# from its dashboard environment variable settings instead.

VITE_API_BASE=http://127.0.0.1:8000
